<%- include('partials/header', { title: 'Trang chủ' }) %>
    <main class="main">
  <div class="container">
    <div class="blog-grid">
      <% recent.forEach(blog => { %>
      <a href="/blog/<%= blog.id %>" class="blog-card">
        <div class="blog-info">
            <h3 class="blog-title"><%= blog.title %></h3>
            <span class="blog-date"><%= blog.created_at.toLocaleDateString('vi-VN') %></span>
          <p class="blog-desc"><%= (blog.description || '').substring(0, 80) %><%= blog.description && blog.description.length > 80 ? '...' : '' %></p>
        </div>
        <div class="blog-view">
          <span class="view-count">👁 <%= blog.view_count %> lượt xem</span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% if (totalPages > 1) { %>
    <div class="pagination" style="margin-top: 30px; display: flex; gap: 10px; justify-content: center; font-size: 3rem;">

        <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="/?page=<%= i %>" class="btn-page <%= currentPage === i ? 'active' : '' %>">
                <%= i %>
            </a>
        <% } %>
    </div>
<% } %>
</main>
</body>
</html>

